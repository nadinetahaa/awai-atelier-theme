<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Google Fonts: Quicksand (headings) + Plus Jakarta Sans (body) — display=swap for performance %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@200;300;400;500;600&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@200;300;400;500;600&display=swap" rel="stylesheet">

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    <main role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% # Cart Drawer (global) %}
    {% render 'cart-drawer' %}

    {% # Scroll-reveal observer — deferred %}
    <script defer>
      (function() {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) entry.target.classList.add('vis');
          });
        }, { threshold: 0.04, rootMargin: '0px 0px -10px 0px' });
        document.querySelectorAll('.rv').forEach(function(el) { obs.observe(el); });
      })();
    </script>

    {% # Cart Drawer JS %}
    <script defer>
      (function() {
        var drawer = document.getElementById('cart-drawer');
        var overlay = document.getElementById('cart-drawer-overlay');
        var closeBtn = document.getElementById('cart-drawer-close');
        if (!drawer || !overlay) return;

        window.openCartDrawer = function() {
          drawer.classList.add('open');
          overlay.classList.add('open');
          document.documentElement.style.overflow = 'hidden';
        };
        function closeDrawer() {
          drawer.classList.remove('open');
          overlay.classList.remove('open');
          document.documentElement.style.overflow = '';
        }
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        overlay.addEventListener('click', closeDrawer);

        /* Auto-open if ?cart_open=1 */
        if (new URLSearchParams(window.location.search).get('cart_open') === '1') {
          window.openCartDrawer();
          var cleanUrl = new URL(window.location);
          cleanUrl.searchParams.delete('cart_open');
          history.replaceState(null, '', cleanUrl.toString());
        }

        /* Cart icon opens drawer instead of navigating */
        document.querySelectorAll('.awai-header__cart').forEach(function(el) {
          el.addEventListener('click', function(e) {
            e.preventDefault();
            window.openCartDrawer();
          });
        });

        /* Quantity update + remove via AJAX */
        drawer.addEventListener('click', function(e) {
          var btn = e.target.closest('.cart-drawer__qty-btn, .cart-drawer__remove');
          if (!btn) return;
          var key = btn.dataset.key;
          var action = btn.dataset.action;
          var qty;

          if (btn.classList.contains('cart-drawer__remove')) {
            qty = 0;
          } else {
            var valEl = btn.parentElement.querySelector('.cart-drawer__qty-val');
            var current = parseInt(valEl.textContent) || 1;
            qty = action === 'minus' ? Math.max(0, current - 1) : current + 1;
          }

          fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: key, quantity: qty })
          })
          .then(function(r) { return r.json(); })
          .then(function() { location.reload(); });
        });
      })();
    </script>
  </body>
</html>
