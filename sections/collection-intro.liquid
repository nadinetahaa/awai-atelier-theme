<div class="collection-intro rv">
  {% if section.settings.tag != blank %}
    <span class="collection-intro__tag">{{ section.settings.tag }}</span>
  {% endif %}
  {% if section.settings.heading != blank %}
    <h2 class="collection-intro__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.description != blank %}
    <p class="collection-intro__desc">{{ section.settings.description }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .collection-intro {
    padding: 80px 28px 16px;
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }

  .collection-intro__tag {
    font-family: var(--font-heading);
    font-size: 0.4rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--ink-f);
    margin-bottom: 14px;
    display: block;
  }

  .collection-intro__heading {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.25;
    color: var(--cocoa);
    margin-bottom: 14px;
  }

  .collection-intro__desc {
    font-size: 0.78rem;
    line-height: 1.85;
    color: var(--ink-l);
    max-width: 440px;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .collection-intro {
      padding: 56px 16px 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Intro",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag line",
      "default": "Collection 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Soft shapes that lift the room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Silhouettes drawn from the gentle geometry of hot air balloons. 3D printed to order from plant-based PLA."
    }
  ],
  "presets": [
    {
      "name": "Collection Intro"
    }
  ]
}
{% endschema %}
