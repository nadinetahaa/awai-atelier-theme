{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign companion = product.metafields.custom.companion_product.value -%}

<section class="pdp-hero full-width" id="pdp-hero">
  <!-- IMAGE GALLERY -->
  <div class="pdp-hero__media">
    {% if product.images.size > 0 %}
      <div class="pdp-hero__gallery" id="pdp-gallery">
        {% for image in product.images %}
          <div class="pdp-hero__slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" data-variant-ids="{% for variant in product.variants %}{% if variant.featured_image == image %}{{ variant.id }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}">
            {{ image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'pdp-hero__img' }}
          </div>
        {% endfor %}
      </div>
      {% if product.images.size > 1 %}
        <div class="pdp-hero__dots" id="pdp-dots">
          {% for image in product.images %}
            <button class="pdp-hero__dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="pdp-hero__placeholder">
        <div class="pdp-hero__frame">
          <svg class="pdp-hero__balloon" viewBox="0 0 65 90">
            <ellipse cx="32" cy="82" rx="22" ry="5" fill="var(--cloud)" opacity=".2"/>
            <rect x="13" y="16" width="39" height="62" rx="19" fill="var(--cloud-s)"/>
            <ellipse cx="32" cy="25" rx="19" ry="4" fill="var(--cloud)" opacity=".15"/>
            <ellipse cx="32" cy="34" rx="19" ry="4" fill="var(--cloud)" opacity=".15"/>
            <ellipse cx="32" cy="43" rx="19" ry="4" fill="var(--cloud)" opacity=".15"/>
            <ellipse cx="32" cy="52" rx="19" ry="4" fill="var(--cloud)" opacity=".15"/>
            <rect x="27" y="74" width="10" height="6" rx="2" fill="var(--cloud)" opacity=".2"/>
          </svg>
        </div>
        <span>Product hero image</span>
      </div>
    {% endif %}
  </div>

  <!-- PRODUCT INFO -->
  <div class="pdp-hero__content">
    {% if section.settings.collection_label != blank %}
      <span class="pdp-hero__collection rv">{{ section.settings.collection_label }}</span>
    {% endif %}

    {%- comment -%}
      Title shows the base product name (without " — Lamp" / " — Sculpture").
      The type goes in the subtitle line.
    {%- endcomment -%}
    {%- assign title_parts = product.title | split: ' — ' -%}
    <h1 class="pdp-hero__title rv d1">{{ title_parts.first }}</h1>

    {%- assign product_type_name = title_parts.last | default: section.settings.subtitle -%}
    {% if product_type_name != blank %}
      <p class="pdp-hero__subtitle rv d2">Hot Air Balloon {{ product_type_name }}</p>
    {% endif %}

    {% if product.description != blank %}
      <p class="pdp-hero__tagline rv d3">{{ product.description }}</p>
    {% endif %}

    <!-- TYPE SELECTOR: current product + companion -->
    <div class="pdp-hero__variants rv d3">
      <div class="pdp-variant active">
        <div class="pdp-variant__name">{{ product.title }}</div>
        {% if section.settings.current_detail != blank %}
          <div class="pdp-variant__detail">{{ section.settings.current_detail }}</div>
        {% endif %}
        <div class="pdp-variant__price">{{ product.price | money }}</div>
      </div>
      {% if companion %}
        <a href="{{ companion.url }}" class="pdp-variant">
          <div class="pdp-variant__name">{{ companion.title }}</div>
          {% if section.settings.companion_detail != blank %}
            <div class="pdp-variant__detail">{{ section.settings.companion_detail }}</div>
          {% endif %}
          <div class="pdp-variant__price">{{ companion.price | money }}</div>
        </a>
      {% endif %}
    </div>

    <!-- COLOR SELECTOR -->
    {% if product.options.size > 0 %}
      {% for option in product.options_with_values %}
        {% if option.name == 'Color' %}
          <div class="pdp-hero__options rv d3">
            <div class="pdp-hero__opt-group">
              <span class="pdp-hero__opt-label">{{ option.name }}</span>
              <div class="pdp-hero__opt-row" id="pdp-color-selector">
                {% for value in option.values %}
                  {% assign is_selected = false %}
                  {% if current_variant.options contains value %}
                    {% assign is_selected = true %}
                  {% endif %}
                  {% if forloop.index > 1 %}
                    <div class="pdp-hero__opt-sep"></div>
                  {% endif %}
                  <button class="pdp-color-btn{% if is_selected %} active{% endif %}" data-color="{{ value }}">{{ value }}</button>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    <!-- CART FORM -->
    {% form 'product', product, id: 'pdp-form', data-ajax-cart: 'true' %}
      <input type="hidden" name="id" id="pdp-variant-id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" id="pdp-qty-input" value="1">

      <div class="pdp-hero__cta rv d4">
        <div class="pdp-qty-stepper">
          <button type="button" class="pdp-qty-btn" id="pdp-qty-minus" aria-label="Decrease quantity">&minus;</button>
          <span class="pdp-qty-val" id="pdp-qty-val">1</span>
          <button type="button" class="pdp-qty-btn" id="pdp-qty-plus" aria-label="Increase quantity">+</button>
        </div>
        <button type="submit" class="btn-primary" id="pdp-add-to-cart">
          Add to Cart &mdash; {{ current_variant.price | money }}
        </button>
      </div>
    {% endform %}

    <!-- META ROW -->
    <div class="pdp-hero__meta rv d5">
      {% if section.settings.registry_url != blank %}
        <a href="{{ section.settings.registry_url }}" class="pdp-registry-link">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 1v14M1 5.5h14M3.5 1C3.5 1 3 3.5 8 5.5M12.5 1c0 0 .5 2.5-4.5 4.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
          {{ section.settings.registry_text | default: 'Add to your registry' }}
        </a>
      {% endif %}
      {% if section.settings.note_text != blank %}
        <span class="pdp-hero__note">{{ section.settings.note_text }}</span>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function() {
  /* --- Variant data --- */
  var variants = [
    {%- for variant in product.variants -%}
      {
        id: {{ variant.id }},
        price: {{ variant.price }},
        priceFormatted: {{ variant.price | money | json }},
        available: {{ variant.available }},
        options: {{ variant.options | json }},
        imageIndex: {% if variant.featured_image %}{{ variant.featured_image.position | minus: 1 }}{% else %}0{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  var currentVariant = variants.find(function(v) { return v.id === {{ current_variant.id }}; }) || variants[0];
  var qty = 1;

  /* --- Elements --- */
  var variantInput = document.getElementById('pdp-variant-id');
  var qtyInput = document.getElementById('pdp-qty-input');
  var qtyVal = document.getElementById('pdp-qty-val');
  var cartBtn = document.getElementById('pdp-add-to-cart');
  var colorBtns = document.querySelectorAll('.pdp-color-btn');
  var slides = document.querySelectorAll('.pdp-hero__slide');
  var dots = document.querySelectorAll('.pdp-hero__dot');
  var form = document.getElementById('pdp-form');

  function updateUI() {
    /* Update hidden inputs */
    variantInput.value = currentVariant.id;
    qtyInput.value = qty;

    /* Update button price: qty * unit price displayed */
    var totalCents = currentVariant.price * qty;
    var totalFormatted = '$' + (totalCents / 100).toFixed(0);
    cartBtn.textContent = 'Add to Cart \u2014 ' + totalFormatted;

    /* Update gallery to show variant image */
    if (slides.length > 0) {
      slides.forEach(function(s) { s.classList.remove('active'); });
      if (slides[currentVariant.imageIndex]) {
        slides[currentVariant.imageIndex].classList.add('active');
      }
    }
    if (dots.length > 0) {
      dots.forEach(function(d) { d.classList.remove('active'); });
      if (dots[currentVariant.imageIndex]) {
        dots[currentVariant.imageIndex].classList.add('active');
      }
    }

    /* Update color buttons */
    colorBtns.forEach(function(btn) {
      var match = currentVariant.options.indexOf(btn.dataset.color) !== -1;
      btn.classList.toggle('active', match);
    });
  }

  /* --- Color selector --- */
  colorBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var color = this.dataset.color;
      var match = variants.find(function(v) { return v.options.indexOf(color) !== -1 && v.available; });
      if (!match) match = variants.find(function(v) { return v.options.indexOf(color) !== -1; });
      if (match) {
        currentVariant = match;
        updateUI();
      }
    });
  });

  /* --- Gallery dots --- */
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(this.dataset.index);
      slides.forEach(function(s) { s.classList.remove('active'); });
      dots.forEach(function(d) { d.classList.remove('active'); });
      if (slides[idx]) slides[idx].classList.add('active');
      this.classList.add('active');
    });
  });

  /* --- Quantity stepper --- */
  document.getElementById('pdp-qty-minus').addEventListener('click', function() {
    if (qty > 1) { qty--; qtyVal.textContent = qty; updateUI(); }
  });
  document.getElementById('pdp-qty-plus').addEventListener('click', function() {
    if (qty < 10) { qty++; qtyVal.textContent = qty; updateUI(); }
  });

  /* --- AJAX Add to Cart --- */
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    cartBtn.disabled = true;
    cartBtn.textContent = 'Adding\u2026';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: parseInt(variantInput.value),
        quantity: qty
      })
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      cartBtn.textContent = 'Added';
      setTimeout(function() {
        cartBtn.disabled = false;
        updateUI();
        /* Reload page to update cart drawer contents, then open it */
        var url = new URL(window.location);
        url.searchParams.set('cart_open', '1');
        window.location = url.toString();
      }, 600);
    })
    .catch(function() {
      cartBtn.textContent = 'Error';
      setTimeout(function() {
        cartBtn.disabled = false;
        updateUI();
      }, 1200);
    });
  });
})();
</script>

{% stylesheet %}
  /* ═══ SCOPED RESET — kill all Shopify inherited styles ═══ */
  .pdp-hero *{box-sizing:border-box}
  .pdp-hero h1,.pdp-hero h2,.pdp-hero h3,.pdp-hero h4,.pdp-hero p,
  .pdp-hero span,.pdp-hero div,.pdp-hero a,.pdp-hero button{
    margin:0 !important;padding:0;border:0;font-size:inherit !important;
    font-weight:inherit !important;line-height:inherit !important;
    color:inherit;text-decoration:none;
  }

  /* ═══ HERO LAYOUT — exact match to HTML reference ═══ */
  .pdp-hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;background:var(--vanille-s);padding-top:72px}

  /* --- Gallery --- */
  .pdp-hero__media{position:relative;overflow:hidden;min-height:600px;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--vanille-s) 0%,var(--vanille) 100%)}
  .pdp-hero__gallery{width:100%;height:100%;position:relative}
  .pdp-hero__slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .4s ease}
  .pdp-hero__slide.active{opacity:1;position:relative}
  .pdp-hero__slide img{width:100%;height:100%;object-fit:cover}
  .pdp-hero__dots{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:8px}
  .pdp-hero__dot{width:6px;height:6px;border-radius:50%;background:var(--ink-f);opacity:.3;border:none;padding:0;cursor:pointer;transition:all .3s}
  .pdp-hero__dot.active{opacity:1;width:20px;border-radius:4px;background:var(--cocoa)}

  /* Placeholder */
  .pdp-hero__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;color:var(--ink-l);font-family:'Quicksand',sans-serif;font-size:.64rem !important;letter-spacing:.15em;text-transform:uppercase;font-weight:500 !important}
  .pdp-hero__frame{width:clamp(280px,60%,420px);aspect-ratio:3/4;border-radius:24px;background:var(--vanille);border:1px solid rgba(61,56,53,.06);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
  .pdp-hero__frame::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(192,206,220,.08) 0px,rgba(192,206,220,.08) 3px,transparent 3px,transparent 7px)}
  .pdp-hero__balloon{width:120px;height:160px;opacity:.15}

  /* --- Content --- */
  .pdp-hero__content{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,8vw,100px);padding-top:clamp(80px,10vw,120px)}

  /* Collection pill */
  .pdp-hero__collection{font-family:'Quicksand',sans-serif;font-size:.48rem !important;font-weight:700 !important;letter-spacing:.4em;text-transform:uppercase;color:var(--ink-f) !important;display:inline-block;background:var(--sf-w);padding:5px 14px !important;border-radius:200px;margin-bottom:20px !important;width:fit-content}

  /* Title */
  .pdp-hero__title{font-family:'Quicksand',sans-serif;font-weight:300 !important;font-size:clamp(2rem,4.5vw,3.2rem) !important;line-height:1.2 !important;color:var(--cocoa) !important;margin-bottom:8px !important}

  /* Subtitle */
  .pdp-hero__subtitle{font-family:'Quicksand',sans-serif;font-weight:400 !important;font-size:clamp(.82rem,1.4vw,1rem) !important;color:var(--ink-m) !important;margin-bottom:32px !important;line-height:1.7 !important}

  /* Description / tagline */
  .pdp-hero__tagline{font-size:.72rem !important;font-weight:300 !important;line-height:1.85 !important;color:var(--ink-l) !important;max-width:440px;margin-bottom:36px !important}

  /* ═══ TYPE SELECTOR (Lamp / Sculpture) ═══ */
  .pdp-hero__variants{display:flex;gap:12px;margin-bottom:32px !important}
  .pdp-variant{padding:14px 20px !important;border-radius:20px;border:1px solid rgba(61,56,53,.08) !important;background:var(--wh);cursor:pointer;transition:all .3s;flex:1;text-align:center;text-decoration:none;display:block;color:var(--cocoa) !important}
  .pdp-variant:hover,.pdp-variant.active{border-color:var(--cocoa) !important;background:var(--sf)}
  .pdp-variant__name{font-family:'Quicksand',sans-serif;font-weight:600 !important;font-size:.68rem !important;letter-spacing:.04em;color:var(--cocoa) !important;margin-bottom:4px !important}
  .pdp-variant__detail{font-size:.62rem !important;color:var(--ink-l) !important;font-weight:300 !important}
  .pdp-variant__price{font-family:'Quicksand',sans-serif;font-weight:500 !important;font-size:.88rem !important;color:var(--cocoa) !important;margin-top:6px !important}

  /* ═══ COLOR SELECTOR ═══ */
  .pdp-hero__options{margin-bottom:28px !important}
  .pdp-hero__opt-label{font-family:'Quicksand',sans-serif;font-size:.42rem !important;font-weight:700 !important;letter-spacing:.35em;text-transform:uppercase;color:var(--ink-f) !important;display:block;margin-bottom:10px !important}
  .pdp-hero__opt-row{display:flex;gap:0;align-items:center}
  .pdp-color-btn{font-family:'Quicksand',sans-serif;font-size:.62rem !important;font-weight:400 !important;color:var(--ink-l) !important;background:none;border:none !important;cursor:pointer;padding:0 !important;transition:all .25s;letter-spacing:.02em;position:relative}
  .pdp-color-btn::after{content:'';position:absolute;bottom:-3px;left:0;right:0;height:1px;background:var(--cocoa);transform:scaleX(0);transition:transform .25s}
  .pdp-color-btn.active{color:var(--cocoa) !important;font-weight:500 !important}
  .pdp-color-btn.active::after{transform:scaleX(1)}
  .pdp-color-btn:hover{color:var(--cocoa) !important}
  .pdp-hero__opt-sep{width:1px;height:12px;background:rgba(61,56,53,.12);margin:0 14px !important;flex-shrink:0}

  /* ═══ QUANTITY + CTA ═══ */
  .pdp-hero__cta{display:flex;gap:0;align-items:center;margin-bottom:24px !important}
  .pdp-qty-stepper{display:flex;align-items:center;border:1px solid rgba(61,56,53,.1) !important;border-radius:200px;overflow:hidden;margin-right:12px !important;flex-shrink:0}
  .pdp-qty-btn{font-family:'Quicksand',sans-serif;font-size:.72rem !important;font-weight:300 !important;color:var(--ink-l) !important;background:none;border:none !important;cursor:pointer;width:38px;height:44px;display:flex;align-items:center;justify-content:center;transition:color .2s}
  .pdp-qty-btn:hover{color:var(--cocoa) !important}
  .pdp-qty-val{font-family:'Quicksand',sans-serif;font-size:.68rem !important;font-weight:500 !important;color:var(--cocoa) !important;min-width:20px;text-align:center}
  .pdp-hero .btn-primary{font-family:'Quicksand',sans-serif;font-weight:600 !important;font-size:.56rem !important;letter-spacing:.25em;text-transform:uppercase;color:var(--wh) !important;background:var(--cocoa);border:none !important;padding:14px 36px !important;border-radius:200px;cursor:pointer;transition:all .3s}
  .pdp-hero .btn-primary:hover{background:#2a2623;transform:translateY(-1px);box-shadow:0 8px 24px rgba(61,56,53,.15)}

  /* ═══ META ROW ═══ */
  .pdp-hero__meta{display:flex;align-items:center;gap:20px}
  .pdp-registry-link{display:inline-flex;align-items:center;gap:6px;font-family:'Quicksand',sans-serif;font-size:.52rem !important;font-weight:500 !important;letter-spacing:.08em;color:var(--ink-l) !important;text-decoration:none;transition:color .3s}
  .pdp-registry-link:hover{color:var(--cocoa) !important}
  .pdp-registry-link svg{opacity:.5;transition:opacity .3s}
  .pdp-registry-link:hover svg{opacity:1}
  .pdp-hero__note{font-family:'Quicksand',sans-serif;font-size:.44rem !important;font-weight:500 !important;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-f) !important}

  /* ═══ RESPONSIVE ═══ */
  @media(max-width:900px){.pdp-hero{grid-template-columns:1fr;min-height:auto}}
  @media(max-width:600px){
    .pdp-hero__content{padding:32px 20px 60px}
    .pdp-hero__variants{flex-direction:column}
    .pdp-hero__meta{flex-direction:column;align-items:flex-start;gap:10px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Hero",
  "settings": [
    {
      "type": "text",
      "id": "collection_label",
      "label": "Collection label",
      "default": "Up, Up and Awai — Collection 01"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product subtitle",
      "default": "Hot Air Balloon Lamp"
    },
    {
      "type": "text",
      "id": "current_detail",
      "label": "Current product detail line",
      "default": "Translucent PLA · Warm glow"
    },
    {
      "type": "text",
      "id": "companion_detail",
      "label": "Companion product detail line",
      "default": "Matte PLA · Décor only"
    },
    {
      "type": "url",
      "id": "registry_url",
      "label": "Registry link URL"
    },
    {
      "type": "text",
      "id": "registry_text",
      "label": "Registry link text",
      "default": "Add to your registry"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note text",
      "default": "Made to order · Free US shipping"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
