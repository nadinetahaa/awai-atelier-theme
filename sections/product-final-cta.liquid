<section class="pdp-final-cta">
  <div class="pdp-final-cta__inner">
    {% if section.settings.heading != blank %}
      <h2 class="pdp-final-cta__heading rv">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="pdp-final-cta__sub rv d1">{{ section.settings.subtext }}</p>
    {% endif %}
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: product.url }}" class="pdp-final-cta__btn btn-primary rv d2">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pdp-final-cta *{box-sizing:border-box}
  .pdp-final-cta h2,.pdp-final-cta p{margin:0 !important;padding:0;font-size:inherit !important;font-weight:inherit !important;line-height:inherit !important}

  .pdp-final-cta__inner{max-width:1100px;margin:0 auto;padding:120px 20px;text-align:center}
  .pdp-final-cta__heading{font-family:'Quicksand',sans-serif;font-weight:300 !important;font-size:clamp(1.6rem,3.5vw,2.6rem) !important;line-height:1.3 !important;color:var(--cocoa) !important;margin-bottom:12px !important}
  .pdp-final-cta__sub{font-size:.86rem !important;line-height:1.7 !important;color:var(--ink-m) !important;margin-bottom:32px !important;max-width:460px;margin-left:auto !important;margin-right:auto !important}
  .pdp-final-cta__btn{font-size:.6rem !important;padding:16px 44px !important}
  @media(max-width:600px){.pdp-final-cta__inner{padding:80px 20px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room needs a little lift." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "3D printed to order in our studio. Plant-based material. Designed for the earliest dreamers." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop The Drifter" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Final CTA" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
