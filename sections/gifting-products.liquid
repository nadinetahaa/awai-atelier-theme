<section class="gift-products">
  <div class="gift-products__inner">
    {% if section.settings.label != blank %}
      <span class="gift-products__label rv">{{ section.settings.label }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="gift-products__heading rv d1">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="gift-products__sub rv d2">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="gift-products__grid">
      {% for block in section.blocks %}
        {%- assign p = block.settings.product -%}
        <div class="gift-card rv d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="gift-card__img">
            {% if p != blank and p.featured_image != blank %}
              <a href="{{ p.url }}">
                {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
              </a>
            {% else %}
              <div class="gift-card__placeholder" style="background: var(--{{ block.settings.placeholder_color | default: 'vanille-s' }})">
                <span>{{ block.settings.placeholder_text | default: 'Product image' }}</span>
              </div>
            {% endif %}
          </div>
          <div class="gift-card__info">
            {% if p != blank %}
              <h3 class="gift-card__name">{{ p.title }}</h3>
              <p class="gift-card__desc">{{ block.settings.description }}</p>
              <div class="gift-card__price">{{ p.price | money }}</div>
              <a href="{{ p.url }}" class="gift-card__link">View Product</a>
            {% else %}
              <h3 class="gift-card__name">{{ block.settings.fallback_title | default: 'Product Name' }}</h3>
              <p class="gift-card__desc">{{ block.settings.description }}</p>
              <div class="gift-card__price">$0.00</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .gift-products__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 28px;
  }
  .gift-products__label {
    font-family: var(--font-heading);
    font-size: 0.44rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-f);
    margin-bottom: 14px;
    display: block;
    text-align: center;
  }
  .gift-products__heading {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.35;
    color: var(--cocoa);
    margin-bottom: 12px;
    text-align: center;
  }
  .gift-products__sub {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--ink-l);
    max-width: 480px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .gift-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .gift-card {
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--wh);
    border: 1px solid rgba(61, 56, 53, 0.04);
    transition: transform 0.3s;
  }
  .gift-card:hover {
    transform: translateY(-3px);
  }
  .gift-card__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    position: relative;
    background: var(--sf);
  }
  .gift-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .gift-card:hover .gift-card__img img {
    transform: scale(1.03);
  }
  .gift-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gift-card__placeholder span {
    font-family: var(--font-heading);
    font-size: 0.4rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(61, 56, 53, 0.18);
  }
  .gift-card__info {
    padding: 24px;
  }
  .gift-card__name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--cocoa);
    margin-bottom: 6px;
  }
  .gift-card__desc {
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--ink-l);
    margin-bottom: 12px;
  }
  .gift-card__price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: var(--ink-m);
    margin-bottom: 14px;
  }
  .gift-card__link {
    font-family: var(--font-heading);
    font-size: 0.46rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-f);
    text-decoration: none;
    transition: color 0.3s;
  }
  .gift-card__link:hover {
    color: var(--cocoa);
  }
  @media (max-width: 600px) {
    .gift-products__inner { padding: 72px 16px; }
    .gift-products__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gifting Products",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Gift Ideas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pieces worth giving."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Each Drifter arrives wrapped in kraft tissue with a hand-stamped sticker. Beautiful enough to give without extra wrapping."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Gift description",
          "default": "A one-of-a-kind nursery piece, printed to order."
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Title (if no product selected)"
        },
        {
          "type": "text",
          "id": "placeholder_color",
          "label": "Placeholder color variable",
          "default": "vanille-s"
        },
        {
          "type": "text",
          "id": "placeholder_text",
          "label": "Placeholder text",
          "default": "Product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gifting Products",
      "blocks": [
        { "type": "product", "settings": { "description": "A warm, glowing lamp that transforms any nursery corner. 3D printed from translucent plant-based PLA.", "fallback_title": "The Drifter \u2014 Lamp", "placeholder_color": "vanille-s" } },
        { "type": "product", "settings": { "description": "A sculptural accent piece for shelves, dressers, or windowsills. Matte finish, beautifully tactile.", "fallback_title": "The Drifter \u2014 Sculpture", "placeholder_color": "cloud-s" } }
      ]
    }
  ]
}
{% endschema %}
