<section class="pdp-specs full-width">
  <div class="pdp-specs__inner">
    {% if section.settings.label != blank %}
      <span class="pdp-specs__label rv">{{ section.settings.label }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="pdp-specs__heading rv d1">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="pdp-specs__grid">
      {% for block in section.blocks %}
        <div class="pdp-spec-card rv d{{ forloop.index | minus: 1 | modulo: 3 | plus: 1 }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.subtitle != blank %}
            <p>{{ block.settings.subtitle }}</p>
          {% endif %}
          <div class="pdp-spec-card__value">{{ block.settings.value }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-specs {
    background: var(--vanille-s);
    padding: 100px 20px;
  }
  .pdp-specs__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .pdp-specs__label {
    font-family: var(--font-heading);
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-f);
    margin-bottom: 14px;
    display: block;
  }
  .pdp-specs__heading {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.35;
    color: var(--cocoa);
    margin-bottom: 40px;
  }
  .pdp-specs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .pdp-spec-card {
    padding: 24px;
    border-radius: 24px;
    background: var(--wh);
    border: 1px solid rgba(61, 56, 53, 0.04);
    transition: transform 0.3s;
  }
  .pdp-spec-card:hover {
    transform: translateY(-2px);
  }
  .pdp-spec-card h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
    color: var(--cocoa);
  }
  .pdp-spec-card p {
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--ink-l);
  }
  .pdp-spec-card__value {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.86rem;
    color: var(--cocoa);
    margin-top: 4px;
  }
  @media (max-width: 600px) {
    .pdp-specs { padding: 80px 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Specs",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every detail, considered."
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dimensions"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "H 50cm × W 30cm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Specs",
      "blocks": [
        { "type": "spec", "settings": { "title": "Dimensions — Large", "subtitle": "Envelope + basket", "value": "H 50cm × W 30cm (20\" × 12\")" } },
        { "type": "spec", "settings": { "title": "Dimensions — Small", "subtitle": "Envelope + basket", "value": "H 40cm × W 22cm (16\" × 9\")" } },
        { "type": "spec", "settings": { "title": "Weight", "subtitle": "Lightweight for hanging", "value": "380–520g depending on size" } },
        { "type": "spec", "settings": { "title": "Lamp — Light Source", "subtitle": "Included LED module", "value": "Warm white 2700K · dimmable" } },
        { "type": "spec", "settings": { "title": "Lamp — Cord", "subtitle": "Fabric-wrapped in Vanille", "value": "3m adjustable length" } },
        { "type": "spec", "settings": { "title": "Material", "subtitle": "Plant-based, biodegradable", "value": "Biosourced PLA filament" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
