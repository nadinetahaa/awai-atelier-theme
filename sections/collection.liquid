{%- comment -%}
  Awai Atelier collection page.
  4-column grid, each variant as its own card.
  Minimal sort/filter bar in the Jacquemus style.
{%- endcomment -%}

{%- comment -%} Collect all unique color values across collection products {%- endcomment -%}
{%- assign all_colors = '' -%}
{%- for product in collection.products -%}
  {%- for option in product.options_with_values -%}
    {%- if option.name == 'Color' -%}
      {%- for value in option.values -%}
        {%- unless all_colors contains value -%}
          {%- if all_colors != '' -%}
            {%- assign all_colors = all_colors | append: ',' | append: value -%}
          {%- else -%}
            {%- assign all_colors = value -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign color_array = all_colors | split: ',' -%}

{%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

<!-- Collection header -->
<div class="col-page__header rv full-width">
  <span class="col-page__label">{{ collection.title }}</span>
  {% if collection.description != blank %}
    <p class="col-page__desc">{{ collection.description }}</p>
  {% endif %}
</div>

<!-- Sort & Filter bar -->
<div class="col-page__toolbar full-width rv">
  <div class="col-page__toolbar-inner">
    <!-- Color filter -->
    {% if color_array.size > 0 %}
      <div class="col-page__filters" id="col-filters">
        <button class="col-filter-btn active" data-color="all">All</button>
        {% for color in color_array %}
          <div class="col-filter-sep"></div>
          <button class="col-filter-btn" data-color="{{ color | handleize }}">{{ color }}</button>
        {% endfor %}
      </div>
    {% else %}
      <div class="col-page__filters"></div>
    {% endif %}

    <!-- Sort -->
    <div class="col-page__sort">
      <div class="col-sort-toggle" id="col-sort-toggle">
        <span class="col-sort-current" id="col-sort-label">
          {%- case current_sort -%}
            {%- when 'best-selling' -%}Featured
            {%- when 'created-descending' -%}Newest
            {%- when 'price-ascending' -%}Price: Low to High
            {%- when 'price-descending' -%}Price: High to Low
            {%- when 'title-ascending' -%}A – Z
            {%- else -%}Sort
          {%- endcase -%}
        </span>
        <svg class="col-sort-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path d="M2.5 4L5 6.5L7.5 4" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="col-sort-dropdown" id="col-sort-dropdown">
        <a href="{{ collection.url }}?sort_by=best-selling" class="col-sort-opt{% if current_sort == 'best-selling' %} active{% endif %}">Featured</a>
        <a href="{{ collection.url }}?sort_by=created-descending" class="col-sort-opt{% if current_sort == 'created-descending' %} active{% endif %}">Newest</a>
        <a href="{{ collection.url }}?sort_by=price-ascending" class="col-sort-opt{% if current_sort == 'price-ascending' %} active{% endif %}">Price: Low to High</a>
        <a href="{{ collection.url }}?sort_by=price-descending" class="col-sort-opt{% if current_sort == 'price-descending' %} active{% endif %}">Price: High to Low</a>
        <a href="{{ collection.url }}?sort_by=title-ascending" class="col-sort-opt{% if current_sort == 'title-ascending' %} active{% endif %}">A – Z</a>
      </div>
    </div>
  </div>
</div>

<!-- Product grid -->
<div class="col-page__grid full-width" id="col-grid">
  {% paginate collection.products by section.settings.products_per_page %}
    {% for product in collection.products %}
      {% for variant in product.variants %}
        {%- assign variant_color = '' -%}
        {%- for option in product.options -%}
          {%- if option == 'Color' -%}
            {%- assign option_index = 'option' | append: forloop.index -%}
            {%- assign variant_color = variant[option_index] | handleize -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ product.url }}?variant={{ variant.id }}" class="pcard rv{% cycle '', ' d1', ' d2', ' d3' %}" data-color="{{ variant_color }}">
          <div class="pcard__img"{% if variant.featured_image == blank and product.featured_image == blank %} style="background: var(--sf)"{% endif %}>
            {% if variant.featured_image != blank %}
              {{ variant.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            {% elsif product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            {% else %}
              <span class="pcard__ph">Product image</span>
            {% endif %}
          </div>
          <div class="pcard__info">
            <div class="pcard__name">{{ product.title }}</div>
            {% if variant.title != 'Default Title' %}
              <div class="pcard__variant">{{ variant.title }}</div>
            {% endif %}
            <div class="pcard__price">{{ variant.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% endfor %}

    {% if paginate.pages > 1 %}
      <nav class="col-page__pagination full-width rv">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

<script>
(function() {
  /* --- Color filter --- */
  var filterBtns = document.querySelectorAll('.col-filter-btn');
  var cards = document.querySelectorAll('#col-grid .pcard');

  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      var color = this.dataset.color;
      cards.forEach(function(card) {
        if (color === 'all' || card.dataset.color === color) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  /* --- Sort dropdown --- */
  var toggle = document.getElementById('col-sort-toggle');
  var dropdown = document.getElementById('col-sort-dropdown');
  if (toggle && dropdown) {
    toggle.addEventListener('click', function(e) {
      e.stopPropagation();
      dropdown.classList.toggle('open');
    });
    document.addEventListener('click', function() {
      dropdown.classList.remove('open');
    });
  }
})();
</script>

{% stylesheet %}
  /* Header */
  .col-page__header {
    padding: 120px 28px 32px;
    text-align: center;
  }
  .col-page__label {
    font-family: var(--font-heading);
    font-size: 0.44rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ink-f);
    display: block;
    margin-bottom: 10px;
  }
  .col-page__desc {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--ink-l);
    max-width: 480px;
    margin: 0 auto;
  }

  /* ═══ Toolbar ═══ */
  .col-page__toolbar {
    padding: 0 28px;
    margin-bottom: 8px;
  }
  .col-page__toolbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid rgba(61, 56, 53, 0.06);
  }

  /* --- Color filter buttons --- */
  .col-page__filters {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    row-gap: 8px;
  }
  .col-filter-btn {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 400;
    color: var(--ink-l);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s;
    letter-spacing: 0.02em;
    position: relative;
  }
  .col-filter-btn::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--cocoa);
    transform: scaleX(0);
    transition: transform 0.25s;
  }
  .col-filter-btn.active {
    color: var(--cocoa);
    font-weight: 500;
  }
  .col-filter-btn.active::after {
    transform: scaleX(1);
  }
  .col-filter-btn:hover {
    color: var(--cocoa);
  }
  .col-filter-sep {
    width: 1px;
    height: 12px;
    background: rgba(61, 56, 53, 0.12);
    margin: 0 14px;
    flex-shrink: 0;
  }

  /* --- Sort dropdown --- */
  .col-page__sort {
    position: relative;
    flex-shrink: 0;
  }
  .col-sort-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 4px 0;
  }
  .col-sort-current {
    font-family: var(--font-heading);
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-l);
    transition: color 0.25s;
  }
  .col-sort-toggle:hover .col-sort-current {
    color: var(--cocoa);
  }
  .col-sort-chevron {
    color: var(--ink-f);
    transition: transform 0.25s;
  }
  .col-sort-dropdown.open + .col-sort-chevron,
  .col-sort-toggle:has(+ .col-sort-dropdown.open) .col-sort-chevron {
    transform: rotate(180deg);
  }
  .col-sort-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--wh);
    border: 1px solid rgba(61, 56, 53, 0.06);
    border-radius: var(--radius-s);
    padding: 8px 0;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(61, 56, 53, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all 0.2s ease;
    z-index: 20;
  }
  .col-sort-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .col-sort-opt {
    display: block;
    padding: 8px 20px;
    font-family: var(--font-heading);
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink-l);
    text-decoration: none;
    transition: all 0.2s;
  }
  .col-sort-opt:hover {
    color: var(--cocoa);
    background: var(--sf);
  }
  .col-sort-opt.active {
    color: var(--cocoa);
    font-weight: 600;
  }

  /* ═══ Grid — 4 columns desktop ═══ */
  .col-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
  }
  .col-page__grid .pcard {
    flex: none;
    min-width: 0;
    width: 100%;
  }

  /* Pagination */
  .col-page__pagination {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 48px 28px 80px;
  }
  .col-page__pagination a,
  .col-page__pagination span {
    font-family: var(--font-heading);
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ink-l);
    text-decoration: none;
    transition: color 0.3s;
    padding: 6px 10px;
  }
  .col-page__pagination a:hover {
    color: var(--cocoa);
  }
  .col-page__pagination span.current {
    color: var(--cocoa);
    font-weight: 700;
    border-bottom: 1px solid var(--cocoa);
  }

  /* ═══ Responsive ═══ */
  @media (max-width: 900px) {
    .col-page__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .col-page__header {
      padding: 96px 16px 24px;
    }
    .col-page__toolbar {
      padding: 0 16px;
    }
    .col-page__toolbar-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .col-page__grid {
      grid-template-columns: 1fr;
    }
    .col-page__pagination {
      padding: 36px 16px 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    }
  ]
}
{% endschema %}
