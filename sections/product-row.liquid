{%- assign collection = section.settings.collection -%}

{% if section.settings.label != blank or section.settings.link_text != blank %}
  <div class="product-row__label rv full-width">
    {% if section.settings.label != blank %}
      <span class="product-row__label-text">{{ section.settings.label }}</span>
    {% endif %}
    {% if section.settings.link_text != blank %}
      <a href="{{ collection.url | default: '#' }}" class="product-row__label-link">{{ section.settings.link_text }}</a>
    {% endif %}
  </div>
{% endif %}

<div class="product-row full-width">
  {% if collection != blank and collection.products.size > 0 %}
    {% for product in collection.products limit: section.settings.products_to_show %}
      <a href="{{ product.url }}" class="pcard rv{% if forloop.index > 1 %} d{{ forloop.index | minus: 1 }}{% endif %}">
        <div class="pcard__img">
          {% if product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            <span class="pcard__ph">Product image</span>
          {% endif %}
        </div>
        <div class="pcard__info">
          <div class="pcard__name">{{ product.title }}</div>
          {% if product.variants.size > 1 %}
            <div class="pcard__variant">{{ product.variants.first.title }}</div>
          {% endif %}
          <div class="pcard__price">{{ product.price | money }}</div>
        </div>
      </a>
    {% endfor %}
  {% else %}
    {% comment %} Placeholder cards when no collection is selected {% endcomment %}
    {% for i in (1..5) %}
      {%- assign colors = 'vanille-s,cloud-s,lila-s,blush-s,sage-s' | split: ',' -%}
      {%- assign color_index = forloop.index0 | modulo: 5 -%}
      <a href="#" class="pcard rv{% if forloop.index > 1 %} d{{ forloop.index | minus: 1 }}{% endif %}">
        <div class="pcard__img" style="background: var(--{{ colors[color_index] }})">
          <span class="pcard__ph">Product image</span>
        </div>
        <div class="pcard__info">
          <div class="pcard__name">Product Name</div>
          <div class="pcard__variant">Variant</div>
          <div class="pcard__price">$0.00</div>
        </div>
      </a>
    {% endfor %}
  {% endif %}
</div>

{% stylesheet %}
  .product-row__label {
    padding: 36px 28px 20px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .product-row__label-text {
    font-family: var(--font-heading);
    font-size: 0.44rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ink-f);
  }

  .product-row__label-link {
    font-family: var(--font-heading);
    font-size: 0.42rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-f);
    transition: color 0.3s;
  }
  .product-row__label-link:hover {
    color: var(--cocoa);
  }

  .product-row {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .product-row::-webkit-scrollbar {
    display: none;
  }

  .pcard {
    flex: 0 0 calc(25% - var(--gap) * 3 / 4);
    min-width: 260px;
    text-decoration: none;
    color: var(--cocoa);
    display: block;
  }

  .pcard__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sf);
  }
  .pcard__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.06) 0px,
      rgba(255, 255, 255, 0.06) 3px,
      transparent 3px,
      transparent 7px
    );
    pointer-events: none;
  }
  .pcard__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pcard:hover .pcard__img img {
    transform: scale(1.03);
  }

  .pcard__ph {
    font-family: var(--font-heading);
    font-size: 0.38rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(61, 56, 53, 0.18);
    position: relative;
    z-index: 1;
  }

  .pcard__info {
    padding: 12px 10px 24px;
  }

  .pcard__name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.72rem;
    margin-bottom: 1px;
  }

  .pcard__variant {
    font-size: 0.62rem;
    font-style: italic;
    color: var(--ink-l);
  }

  .pcard__price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.46rem;
    letter-spacing: 0.1em;
    color: var(--ink-m);
    margin-top: 4px;
  }

  @media (max-width: 600px) {
    .product-row__label {
      padding: 28px 16px 14px;
    }
    .pcard {
      flex: 0 0 72%;
      min-width: 220px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Row",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Row label",
      "default": "The Drifter — Lamp"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View all link text",
      "default": "View All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Product Row"
    }
  ]
}
{% endschema %}
