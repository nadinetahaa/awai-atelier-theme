<section class="hero full-width">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, class: 'hero__video' }}
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero__image', loading: 'eager' }}
    {% else %}
      <div class="hero__placeholder">
        <span>Hero image or video</span>
      </div>
    {% endif %}
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_link }}" class="hero__cta">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 580px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero__media img,
  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(165deg, #3a3632 0%, #5a5550 30%, #8a8580 55%, var(--cloud) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__placeholder span {
    font-family: var(--font-heading);
    font-size: 0.44rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.14);
    font-weight: 500;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, transparent 50%, rgba(0, 0, 0, 0.06) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: 0 28px 52px;
    max-width: 520px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    line-height: 1.12;
    color: #fff;
    margin-bottom: 18px;
    opacity: 0;
    animation: hero-fade 0.7s ease forwards 0.5s;
  }

  .hero__cta {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.44rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.3s;
    opacity: 0;
    animation: hero-fade 0.7s ease forwards 0.8s;
  }
  .hero__cta:hover {
    color: #fff;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 600px) {
    .hero__content {
      padding: 0 16px 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (overrides image)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Up, Up and Awai."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
