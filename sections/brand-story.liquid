<section class="brand-story">
  <div class="brand-story__inner">
    <!-- Visual -->
    <div class="brand-story__visual rv">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      {% else %}
        <div class="brand-story__vis-ph">
          <span>{{ section.settings.placeholder_text | default: 'Studio / process image' }}</span>
        </div>
      {% endif %}
    </div>

    <!-- Text -->
    <div class="brand-story__text">
      {% if section.settings.label != blank %}
        <div class="brand-story__label rv">{{ section.settings.label }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="brand-story__heading rv d1">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="brand-story__body rv d2">{{ section.settings.body }}</p>
      {% endif %}

      <div class="brand-story__facts rv d3">
        {% for block in section.blocks %}
          <div class="brand-story__fact" {{ block.shopify_attributes }}>
            <div class="brand-story__fact-label">{{ block.settings.label }}</div>
            <div class="brand-story__fact-value">{{ block.settings.value }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-story {
    padding: 0 28px;
    margin: 80px 0;
  }

  .brand-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    max-width: none;
  }

  /* Visual */
  .brand-story__visual {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--vanille-s);
  }
  .brand-story__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(192, 206, 220, 0.04) 0px,
      rgba(192, 206, 220, 0.04) 4px,
      transparent 4px,
      transparent 8px
    );
    pointer-events: none;
  }
  .brand-story__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-story__vis-ph {
    width: 100%;
    height: 100%;
    background: linear-gradient(155deg, var(--vanille-s) 0%, var(--sage-s) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-story__vis-ph span {
    font-family: var(--font-heading);
    font-size: 0.42rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-f);
  }

  /* Text */
  .brand-story__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 6vw, 80px);
  }

  .brand-story__label {
    font-family: var(--font-heading);
    font-size: 0.4rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-f);
    margin-bottom: 18px;
  }

  .brand-story__heading {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    line-height: 1.4;
    color: var(--cocoa);
    margin-bottom: 18px;
  }

  .brand-story__body {
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--ink-l);
    max-width: 420px;
    margin-bottom: 28px;
  }

  /* Facts */
  .brand-story__facts {
    display: flex;
    gap: 28px;
  }

  .brand-story__fact-label {
    font-family: var(--font-heading);
    font-size: 0.38rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-f);
    margin-bottom: 3px;
  }

  .brand-story__fact-value {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 0.74rem;
    color: var(--cocoa);
  }

  /* Responsive */
  @media (max-width: 800px) {
    .brand-story__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .brand-story {
      padding: 0 16px;
      margin: 56px 0;
    }
    .brand-story__text {
      padding: 28px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text (when no image)",
      "default": "Studio / process image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "The Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for the rooms where imagination begins."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Every piece is 3D printed layer by layer from plant-based PLA. Made to order — no warehouses, no dead stock. The visible ridges of the printing process become a signature texture, catching light and inviting touch."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Fact label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Fact value",
          "default": "Plant-based PLA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "label": "Material",
            "value": "Plant-based PLA"
          }
        },
        {
          "type": "fact",
          "settings": {
            "label": "Process",
            "value": "3D printed to order"
          }
        },
        {
          "type": "fact",
          "settings": {
            "label": "Studio",
            "value": "Houston, TX"
          }
        }
      ]
    }
  ]
}
{% endschema %}
